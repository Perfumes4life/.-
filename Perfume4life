<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>عطر ديفاكتو سي أكوا</title>
<style>
  :root {
    --bg: #f2f5f1;
    --surface: #ffffff;
    --ink: #13241f;
    --muted: #51625d;
    --teal: #0e6b5c;
    --teal-dark: #0a4f44;
    --saffron: #f2a900;
    --line: #d5ddd8;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1a17;
      --surface: #172622;
      --ink: #eef3f0;
      --muted: #a4b5af;
      --teal: #35b59f;
      --teal-dark: #278c7a;
      --saffron: #f2b630;
      --line: #2a3d37;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: "Segoe UI", Tahoma, "Noto Naskh Arabic", system-ui, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.8;
    padding-bottom: 84px;
  }
  a, button, input, select, textarea { font: inherit; }
  :focus-visible { outline: 3px solid var(--saffron); outline-offset: 2px; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 18px; }

  /* top strip */
  .strip { background: var(--teal-dark); color: #fff; text-align: center; font-size: 14px; padding: 8px 12px; }

  /* hero */
  .hero { padding: 22px 0 8px; }
  .gallery {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }
  .gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .placeholder { text-align: center; color: var(--muted); padding: 24px; }
  .placeholder svg { width: 96px; height: 96px; margin-bottom: 10px; }
  .thumbs { display: flex; gap: 10px; margin-top: 10px; overflow-x: auto; }
  .thumbs button {
    flex: 0 0 64px; height: 64px; border-radius: 12px; overflow: hidden;
    border: 2px solid transparent; background: var(--surface); cursor: pointer; padding: 0;
  }
  .thumbs button[aria-current="true"] { border-color: var(--saffron); }
  .thumbs img { width: 100%; height: 100%; object-fit: cover; }

  h1 { font-size: clamp(26px, 6.5vw, 38px); line-height: 1.35; margin: 20px 0 6px; }
  .sub { color: var(--muted); font-size: 17px; }

  .price-row { display: flex; align-items: baseline; gap: 12px; margin: 16px 0 4px; flex-wrap: wrap; }
  .price { font-size: 34px; font-weight: 800; color: var(--teal); }
  .old { color: var(--muted); text-decoration: line-through; font-size: 18px; }
  .save { background: var(--saffron); color: #2a1d00; font-weight: 700; font-size: 14px; padding: 2px 10px; border-radius: 999px; }
  .cod { color: var(--muted); font-size: 15px; }

  .btn {
    display: inline-block; text-align: center; text-decoration: none; cursor: pointer;
    background: var(--teal); color: #fff; border: 0; border-radius: 14px;
    padding: 14px 22px; font-weight: 700; font-size: 18px;
  }
  .btn:hover { background: var(--teal-dark); }
  .btn.block { display: block; width: 100%; }
  .btn.wa { background: #1f9d55; }
  .btn.wa:hover { background: #167a42; }
  .cta { margin: 18px 0 6px; }

  /* sections */
  section { padding: 30px 0 6px; }
  h2 { font-size: 24px; margin-bottom: 14px; }
  .feat { list-style: none; display: grid; gap: 12px; }
  .feat li {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 14px; padding: 14px 16px;
  }
  .feat .tick {
    flex: 0 0 26px; height: 26px; border-radius: 50%;
    background: var(--teal); color: #fff; display: grid; place-items: center; font-size: 15px; margin-top: 2px;
  }
  .feat strong { display: block; }
  .feat span.d { color: var(--muted); font-size: 15px; }

  .specs { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .specs th, .specs td { text-align: right; padding: 11px 16px; border-bottom: 1px solid var(--line); font-size: 16px; }
  .specs tr:last-child th, .specs tr:last-child td { border-bottom: 0; }
  .specs th { width: 38%; color: var(--muted); font-weight: 600; }

  /* order form */
  .order { background: var(--surface); border: 2px solid var(--teal); border-radius: 20px; padding: 20px; }
  .order h2 { margin-bottom: 4px; }
  .order p.note { color: var(--muted); font-size: 15px; margin-bottom: 16px; }
  label { display: block; font-weight: 600; margin: 12px 0 4px; font-size: 16px; }
  input, select, textarea {
    width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); font-size: 17px;
  }
  textarea { min-height: 76px; resize: vertical; }
  .qty { display: flex; align-items: center; gap: 10px; }
  .qty button {
    width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); font-size: 22px; cursor: pointer;
  }
  .qty output { min-width: 36px; text-align: center; font-size: 20px; font-weight: 700; }
  .total { display: flex; justify-content: space-between; margin: 18px 0 12px; padding-top: 14px; border-top: 1px dashed var(--line); font-size: 18px; }
  .total b { color: var(--teal); font-size: 22px; }
  .payinfo { background: var(--bg); border: 1px dashed var(--teal); border-radius: 12px; padding: 10px 14px; margin-top: 10px; font-size: 15px; }
  .err { color: #c0392b; font-size: 14px; min-height: 20px; margin-top: 8px; }
  @media (prefers-color-scheme: dark) { .err { color: #ff8a7a; } }

  details {
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    padding: 12px 16px; margin-bottom: 10px;
  }
  summary { cursor: pointer; font-weight: 700; }
  details p { color: var(--muted); margin-top: 8px; font-size: 16px; }

  footer { text-align: center; color: var(--muted); font-size: 14px; padding: 30px 0 10px; }

  /* sticky bar */
  .bar {
    position: fixed; inset-inline: 0; bottom: 0; z-index: 10;
    background: var(--surface); border-top: 1px solid var(--line);
    padding: 10px 18px; display: flex; align-items: center; gap: 14px;
  }
  .bar .p { font-weight: 800; font-size: 20px; color: var(--teal); white-space: nowrap; }
  .bar .btn { flex: 1; padding: 12px; }

  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
</head>
<body>

<div class="strip" id="strip"></div>

<main class="wrap">
  <header class="hero">
    <div class="gallery" id="gallery"></div>
    <div class="thumbs" id="thumbs"></div>

    <h1 id="name"></h1>
    <p class="sub" id="tagline"></p>

    <div class="price-row">
      <span class="price" id="price"></span>
      <span class="old" id="old"></span>
      <span class="save" id="save"></span>
    </div>
    <p class="cod">الدفع بفودافون كاش أو إنستا باي.</p>

    <div class="cta"><a class="btn block" href="#order">اطلب دلوقتي</a></div>
  </header>

  <section>
    <h2>ليه المنتج ده؟</h2>
    <ul class="feat" id="features"></ul>
  </section>

  <section>
    <h2>المواصفات</h2>
    <table class="specs" id="specs"></table>
  </section>

  <section id="order">
    <div class="order">
      <h2>اطلب دلوقتي</h2>
      <p class="note">املا البيانات واختار طريقة الدفع، وهنكمل الطلب معاك على واتساب.</p>

      <label for="fname">الاسم</label>
      <input id="fname" autocomplete="name" placeholder="اسمك بالكامل">

      <label for="fphone">رقم الموبايل</label>
      <input id="fphone" type="tel" inputmode="tel" autocomplete="tel" placeholder="01xxxxxxxxx">

      <label for="fgov">المحافظة</label>
      <select id="fgov"></select>

      <label for="faddr">العنوان بالتفصيل</label>
      <textarea id="faddr" placeholder="الشارع، رقم العمارة، علامة مميزة"></textarea>

      <label>الكمية</label>
      <div class="qty">
        <button type="button" id="minus" aria-label="قلل الكمية">−</button>
        <output id="qty">1</output>
        <button type="button" id="plus" aria-label="زوّد الكمية">+</button>
      </div>

      <label for="fpay">طريقة الدفع</label>
      <select id="fpay">
        <option value="vodafone">فودافون كاش</option>
        <option value="insta">إنستا باي</option>
      </select>
      <p class="payinfo" id="payinfo"></p>

      <div class="total"><span>الإجمالي (شامل الشحن)</span><b id="total"></b></div>
      <button class="btn wa block" id="send" type="button">أكّد الطلب على واتساب</button>
      <p class="err" id="err" role="alert"></p>
    </div>
  </section>

  <section>
    <h2>أسئلة بتتكرر</h2>
    <details><summary>التوصيل بياخد قد إيه؟</summary><p id="faq-ship"></p></details>
    <details><summary>أدفع إزاي؟</summary><p id="faq-pay"></p></details>
    <details><summary>لو المنتج مش عاجبني؟</summary><p id="faq-return"></p></details>
  </section>

  <footer id="foot"></footer>
</main>

<div class="bar">
  <span class="p" id="barprice"></span>
  <a class="btn" href="#order">اطلب دلوقتي</a>
</div>

<script>
/* ============================================================
   عدّل هنا بس. كل الصفحة بتتبني من الإعدادات دي.
   ============================================================ */
const CONFIG = {
  name: "عطر ديفاكتو سي أكوا - أو دو بارفان",
  tagline: "رائحة بحرية منعشة لاستخدامك اليومي.",
  price: 500,            // سعر القطعة بالجنيه
  oldPrice: 1000,        // السعر القديم، اتركه 0 لو مفيش سعر قديم حقيقي
  shipping: 50,          // مصاريف الشحن، 0 لو الشحن مجاني
  whatsapp: "201031832817", // رقمك بالصيغة الدولية بدون +
  payVodafone: "01031832817",   // رقم فودافون كاش بتاعك
  payInsta: "yourname@instapay", // عنوان إنستا باي بتاعك
  sheetUrl: "",         // رابط Google Apps Script لتسجيل الطلبات في شيت (اتركه فاضي لو مش عايزه)
  strip: "شحن لكل المحافظات والدفع فودافون كاش أو إنستا باي",
  images: ["data:image/jpeg;base64,"],
  features: [
    ["أو دو بارفان", "تركيز عطري أعلى من العطور الخفيفة."],
    ["زجاجة أنيقة", "تصميم بسيط وشكل مناسب للهدية."],
    ["لاستخدام يومي", "رائحة منعشة تناسب الشغل والخروج."]
  ],
  specs: [
    ["الماركة", "DeFacto"],
    ["الاسم", "Sea Aqua"],
    ["النوع", "Eau de Parfum"],
    ["الحجم", "250 مل"]
  ],
  shipText: "من 2 إلى 5 أيام عمل حسب محافظتك.",
  returnText: "لو وصلك المنتج بعيب أو مش زي الطلب، كلمنا على واتساب في نفس اليوم ونحلها معاك.",
  brand: "اسم متجرك"
};
/* ============================================================ */

const GOVS = ["القاهرة","الجيزة","الإسكندرية","القليوبية","الشرقية","الدقهلية","الغربية","المنوفية","البحيرة","كفر الشيخ","دمياط","بورسعيد","الإسماعيلية","السويس","الفيوم","بني سويف","المنيا","أسيوط","سوهاج","قنا","الأقصر","أسوان","الوادي الجديد","مطروح","شمال سيناء","جنوب سيناء","البحر الأحمر"];
const $ = id => document.getElementById(id);
const fmt = n => n.toLocaleString("ar-EG") + " ج";

document.title = CONFIG.name;
$("strip").textContent = CONFIG.strip;
$("name").textContent = CONFIG.name;
$("tagline").textContent = CONFIG.tagline;
$("price").textContent = fmt(CONFIG.price);
$("barprice").textContent = fmt(CONFIG.price);
if (CONFIG.oldPrice > CONFIG.price) {
  $("old").textContent = fmt(CONFIG.oldPrice);
  $("save").textContent = "وفّر " + fmt(CONFIG.oldPrice - CONFIG.price);
}
$("faq-ship").textContent = CONFIG.shipText;
$("faq-return").textContent = CONFIG.returnText;
$("faq-pay").textContent = "الدفع بفودافون كاش أو إنستا باي. بعد التحويل ابعت صورة الإيصال على واتساب وهنشحن طلبك.";
$("foot").textContent = CONFIG.brand;

// gallery
const gal = $("gallery"), thumbs = $("thumbs");
if (CONFIG.images.length) {
  const main = document.createElement("img");
  main.alt = CONFIG.name; main.src = CONFIG.images[0];
  gal.appendChild(main);
  if (CONFIG.images.length > 1) {
    CONFIG.images.forEach((src, i) => {
      const b = document.createElement("button");
      b.type = "button"; b.setAttribute("aria-label", "صورة " + (i + 1));
      b.setAttribute("aria-current", i === 0);
      const im = document.createElement("img"); im.src = src; im.alt = "";
      b.appendChild(im);
      b.onclick = () => {
        main.src = src;
        [...thumbs.children].forEach(c => c.setAttribute("aria-current", c === b));
      };
      thumbs.appendChild(b);
    });
  }
} else {
  gal.innerHTML = '<div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="1.6"/><path d="M21 15l-5-5L5 21"/></svg><div>حط صورة المنتج هنا<br>(images في الإعدادات)</div></div>';
}

// features + specs
CONFIG.features.forEach(([t, d]) => {
  const li = document.createElement("li");
  li.innerHTML = '<span class="tick" aria-hidden="true">✓</span><div><strong></strong><span class="d"></span></div>';
  li.querySelector("strong").textContent = t;
  li.querySelector(".d").textContent = d;
  $("features").appendChild(li);
});
CONFIG.specs.forEach(([k, v]) => {
  const tr = document.createElement("tr");
  tr.innerHTML = "<th></th><td></td>";
  tr.children[0].textContent = k; tr.children[1].textContent = v;
  $("specs").appendChild(tr);
});

// governorates
$("fgov").innerHTML = '<option value="">اختار المحافظة</option>' + GOVS.map(g => `<option>${g}</option>`).join("");

// quantity + total
let qty = 1;
function render() {
  $("qty").textContent = qty.toLocaleString("ar-EG");
  $("total").textContent = fmt(CONFIG.price * qty + CONFIG.shipping);
  payInfo();
}
function payInfo() {
  const v = $("fpay").value === "vodafone";
  const total = CONFIG.price * qty + CONFIG.shipping;
  $("payinfo").textContent = "حوّل " + fmt(total) + " على " + (v ? "فودافون كاش: " + CONFIG.payVodafone : "إنستا باي: " + CONFIG.payInsta) + ". وبعد التحويل ابعت صورة الإيصال على واتساب.";
}
$("fpay").onchange = payInfo;
$("minus").onclick = () => { if (qty > 1) { qty--; render(); } };
$("plus").onclick = () => { if (qty < 10) { qty++; render(); } };
render();

// send to WhatsApp
$("send").onclick = () => {
  const name = $("fname").value.trim();
  const phone = $("fphone").value.trim().replace(/\s/g, "");
  const gov = $("fgov").value;
  const addr = $("faddr").value.trim();
  const err = $("err");
  if (!name) return err.textContent = "اكتب اسمك.";
  if (!/^(\+?20|0)?1[0125]\d{8}$/.test(phone)) return err.textContent = "رقم الموبايل مش مظبوط، مثال: 01012345678";
  if (!gov) return err.textContent = "اختار المحافظة.";
  if (addr.length < 8) return err.textContent = "اكتب العنوان بالتفصيل.";
  err.textContent = "";
  const total = CONFIG.price * qty + CONFIG.shipping;
  const payLabel = $("fpay").value === "vodafone" ? "فودافون كاش" : "إنستا باي";
  const msg =
`طلب جديد
المنتج: ${CONFIG.name}
الكمية: ${qty}
الاسم: ${name}
الموبايل: ${phone}
المحافظة: ${gov}
العنوان: ${addr}
الإجمالي شامل الشحن: ${total} جنيه
طريقة الدفع: ${payLabel} (هبعت صورة التحويل)`;
  if (CONFIG.sheetUrl) {
    try {
      fetch(CONFIG.sheetUrl, {
        method: "POST", mode: "no-cors", keepalive: true,
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({ product: CONFIG.name, name, phone, gov, address: addr, qty, total, pay: payLabel })
      });
    } catch (e) {}
  }
  window.open("https://wa.me/" + CONFIG.whatsapp + "?text=" + encodeURIComponent(msg), "_blank");
};
</script>
</body>
</html>
